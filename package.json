{
  "name": "algoverse",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:engines": "tsx scripts/check-engines.mts",
    "check:comics": "tsx scripts/check-comic-kit.mts",
    "check": "npm run check:engines && npm run check:comics && npm run check:words",
    "experiment": "tsx --conditions=react-server --env-file=.env.local scripts/experiment.mts",
    "check:words": "node scripts/scan-words.mjs",
    "seed:demo": "tsx --conditions=react-server scripts/seed-demo.mts",
    "expand:bank": "tsx --conditions=react-server --env-file=.env.local scripts/expand-bank.mts",
    "normalize:banks": "tsx scripts/normalize-banks.mts"
  },
  "dependencies": {
    "@google/genai": "^2.27.0",
    "better-sqlite3": "^13.0.3",
    "framer-motion": "^14.0.0",
    "lucide-react": "^1.52.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
